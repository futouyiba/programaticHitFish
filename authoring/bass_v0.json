            "owner_policy": ["ENGAGEMENT_MODE"],
            "required": true
          },
          {
            "key": "daylight_sensitivity",
            "type": "float",
            "owner_policy": ["ENGAGEMENT_MODE", "SHARED_PROFILE"],
            "required": true
          },
          {
            "key": "water_temperature",
            "type": "float",
            "owner_policy": ["ENVIRONMENT_FACT"],
            "required": true
          }
        ],
        "dsl": "let weight = 1.0\nif structure_affinity < thermal_stability_min: return 0.01 * weight\nreturn weight * structure_affinity"
      },
      {
        "id": "BAKE_SPAWN_GUARD",
        "required_params": [
