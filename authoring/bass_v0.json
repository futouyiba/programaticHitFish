        "id": "BAKE_ACTIVE_SPAWNING",
        "required_params": [
          {
            "key": "structure_affinity",
            "type": "float",
            "owner_policy": ["ENGAGEMENT_MODE", "SPECIES_SHARED"],
            "required": true
          },
          {
            "key": "thermal_stability_min",
