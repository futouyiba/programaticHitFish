            "owner_policy": ["ENGAGEMENT_MODE", "SHARED_PROFILE"],
            "required": true
          },
          {
            "key": "water_temperature",
            "type": "float",
            "owner_policy": ["ENVIRONMENT_FACT"],
            "required": true
          }
        ],
        "dsl": "let weight = 1.0\nrule structure {\nweight = weight * structure_affinity\n}\nif weight < 0.05: return 0.01 * weight\nreturn weight * normal_bias"
      },
